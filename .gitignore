# Rust
target/
**/*.rs.bk

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Runtime / local data (never commit — may contain secrets, tokens, job logs)
data/
example/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Node / Dashboard
dashboard/node_modules/
dashboard/dist/
.pnpm-store/

# Config with secrets (use *.example.toml or placeholders in committed samples)
*.local.toml
.env
.env.*
**/conf/*.local.toml

# Hugo docs
docs/public/
docs/.hugo_build.lock
docs/logs/

# Local runner logs (may contain hostnames / runtime noise)
example/logs/
logs/

# Plugin signing keys NEVER live in the repo (the signature proves the index
# was not rewritten; a committed key would prove nothing). Keep the keypair in
# a CI secret / secret manager — see docs → Plugin Tooling → Sign the index.
signing-key*.json
*-signing-key.json
*.ed25519
